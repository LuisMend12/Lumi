# Copy to backend/.env and fill in. backend/.env is ignored by git; never commit real values.

# Tiger Data (managed PostgreSQL). Copy these from the Tiger Cloud console after rotating the password.
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=require

# Clerk sign-in (#14). Public values from the Clerk dashboard (API keys). No secret key is needed.
# Without them, reports and votes answer 503.
CLERK_ISSUER=
CLERK_JWKS_URL=
