# Copy to frontend/.env.local and fill in. .env.local is ignored by git; never commit real values.

# Backend URL (default http://127.0.0.1:8000)
# NEXT_PUBLIC_API_URL=

# Set to "true" to use sample data instead of the backend (shows a "Mock data" banner)
# NEXT_PUBLIC_USE_MOCKS=

# Clerk (#14). Clerk dashboard -> API keys. The publishable key is public; the secret key is not.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
